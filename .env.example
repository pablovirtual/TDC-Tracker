# Variables de Entorno - Financial Cutoff Tracker

# Copia este archivo como .env.local y completa los valores

# ================================
# SUPABASE
# ================================
# Obtén estos valores desde tu proyecto en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ================================
# NEXT.JS
# ================================
# URL base de tu aplicación (para producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# OPCIONAL: Database (si usas Prisma ORM)
# ================================
# DATABASE_URL=postgresql://usuario:password@host:5432/database

# ================================
# NOTAS IMPORTANTES
# ================================
# 1. Nunca subas el archivo .env.local a git
# 2. Asegúrate de que .env.local esté en tu .gitignore
# 3. Las variables que empiezan con NEXT_PUBLIC_ estarán disponibles en el cliente
# 4. Las variables sin NEXT_PUBLIC_ solo estarán disponibles en el servidor
